generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String      @default("INDIVIDUAL")
  createdAt     DateTime    @default(now())
  accounts      Account[]
  sessions      Session[]
  individual    Individual?
  company       Company?    @relation(fields: [companyId], references: [id])
  companyId     String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  website     String?
  industry    String?
  logoUrl     String?
  description String?
  location    String?
  size        String?
  createdAt   DateTime     @default(now())
  users       User[]
  jobPostings JobPosting[]
}

model JobPosting {
  id            String           @id @default(cuid())
  companyId     String
  title         String
  description   String?
  location      String?
  jobType       String           @default("full_time")
  experienceMin Int?
  experienceMax Int?
  salaryMin     Decimal?         @db.Decimal(10, 2)
  salaryMax     Decimal?         @db.Decimal(10, 2)
  skills        String[]
  status        String           @default("active")
  createdAt     DateTime         @default(now())
  company       Company          @relation(fields: [companyId], references: [id])
  applications  JobApplication[]
}

model Individual {
  id              String           @id @default(cuid())
  userId          String           @unique
  headline        String?
  location        String?
  phone           String?
  linkedin        String?
  github          String?
  portfolio       String?
  currentRole     String?
  currentCompany  String?
  totalExperience Int?
  skills          String[]
  bio             String?
  resumeUrl       String?
  isOpenToWork    Boolean          @default(true)
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    JobApplication[]
  experiences     WorkExperience[]
}

model WorkExperience {
  id           String     @id @default(cuid())
  individualId String
  role         String
  company      String
  startDate    DateTime?  @db.Date
  endDate      DateTime?  @db.Date
  description  String?
  individual   Individual @relation(fields: [individualId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id           String     @id @default(cuid())
  jobId        String
  individualId String
  coverLetter  String?
  matchScore   Decimal?   @db.Decimal(5, 2)
  status       String     @default("applied")
  appliedAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  notes        String?
  job          JobPosting @relation(fields: [jobId], references: [id])
  individual   Individual @relation(fields: [individualId], references: [id])

  @@unique([jobId, individualId])
}
