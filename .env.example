# ──────────────────────────────────────────────────────────────────────────────
# AI Career Copilot — Environment Configuration Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (never commit .env) and fill in real values.
# .env is listed in .gitignore and must NEVER be committed.
#
# Credential sources:
#   DATABASE_URL  → https://console.neon.tech  (Neon Postgres project settings)
#   AUTH_SECRET   → Generate with: openssl rand -hex 32
#   AUTH_GITHUB_* → https://github.com/settings/developers  (OAuth Apps)
#   AUTH_GOOGLE_* → https://console.cloud.google.com  (OAuth 2.0 Credentials)
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon serverless or compatible)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

# ── Auth.js ──────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens and encrypt session data.
# MUST be at least 32 characters of cryptographically random bytes.
# Generate with: openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_PLUS_CHAR_SECRET"

# ── GitHub OAuth Provider ─────────────────────────────────────────────────────
# Register at: https://github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:8080/api/auth/callback/github  (dev)
AUTH_GITHUB_ID="REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID"
AUTH_GITHUB_SECRET="REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET"

# ── Google OAuth Provider (optional) ─────────────────────────────────────────
# Register at: https://console.cloud.google.com → APIs & Services → Credentials
# Callback URL: http://localhost:8080/api/auth/callback/google  (dev)
# AUTH_GOOGLE_ID="REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID"
# AUTH_GOOGLE_SECRET="REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET"

# ── ML Service ───────────────────────────────────────────────────────────────
# URL for the local FastAPI ML service.
# Default value (below) works for local development; no change needed unless
# you deploy the ML service separately.
# VITE_ML_SERVICE_URL="http://localhost:8000/analyze-resume"

# ── Security notes ───────────────────────────────────────────────────────────
# • Never set NODE_ENV=production with placeholder values above.
# • For production, inject secrets through your hosting platform's secret store
#   (e.g. Vercel Environment Variables, Netlify env settings, AWS SSM).
# • Rotate any secret that was previously exposed in source control or logs.
